# SOUL THEORY — Environment Variables Example
# Duplicate this file as .env.local for development

# Storefront URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay Payment Gateway (Test Mode / Live Mode)
# Replace with your test credentials from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholderKey123
RAZORPAY_KEY_SECRET=rzp_secret_placeholderSecret456

# Optional: Transactional Email Service (Resend / Sendgrid)
# RESEND_API_KEY=re_placeholderApiKey789

# Optional: Google Analytics 4 (Only activated upon DPDP user consent)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
